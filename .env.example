# sg-legal-help environment — copy to .env (never commit .env).
# Uncomment only what the resources actually use.

# --- AI summaries (any OpenAI-compatible endpoint) ---
# Summaries are skipped gracefully if these are unset (the build still runs).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional SOCKS proxy to reach a local LLM over Tailscale (auto-set by the agent sidecar).
# TAILSCALE_PROXY=

# --- Optional article extraction (not used by the LawGoWhere crawler) ---
# JINA_API_TOKEN=

# --- Optional PDF / complex extraction (not used yet) ---
# DOCLING_SERVE_URL=
# DOCLING_SERVE_API_KEY=

# --- Crawl pacing overrides (defaults are conservative) ---
# SGLEGALHELP_DELAY_SECONDS=2.0
# SGLEGALHELP_JITTER_SECONDS=1.0

# --- Deploy to S3 (data.zeeker.sg) — only needed once deploy is enabled ---
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
